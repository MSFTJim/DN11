@page "/productdashboard"
@implements IDisposable
@using Microsoft.AspNetCore.Components.QuickGrid
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using jfvQuickGrid.Models
@using jfvQuickGrid.Services
@using jfvQuickGrid.Components.Shared
@inject IProductService ProductService
@inject NotificationService NotificationService
@inject ToastService ToastService
@inject ILogger<ProductDashboard> Logger

<PageTitle>Product Dashboard</PageTitle>

<section class="card card-surface mb-4" aria-labelledby="page-heading">
    <div class="card-body">
        <h1 id="page-heading" class="h2 mb-0">Product Dashboard</h1>
        @if (!isLoading && loadError is null)
        {
            <dl class="row g-3 mb-0 dashboard-metrics" aria-label="Product metrics">
                <div class="col-6 col-md-3">
                    <div class="metric-card">
                        <dt>Products</dt>
                        <dd>@products.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-card">
                        <dt>Categories</dt>
                        <dd>@categoryCounts.Count.ToString("N0", CultureInfo.InvariantCulture)</dd>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-card">
                        <dt>Avg Price</dt>
                        <dd>@(averagePrice?.ToString("$#,##0", CultureInfo.InvariantCulture) ?? "—")</dd>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-card">
                        <dt>Inventory</dt>
                        <dd>@totalInventory.ToString("N0", CultureInfo.InvariantCulture)</dd>
                    </div>
                </div>
            </dl>
        }
    </div>
</section>

@if (isLoading)
{
    <p>Loading products...</p>
}
else if (loadError is not null)
{
    <p class="text-danger" role="alert">@loadError</p>
}
else
{
    <div class="container-fluid px-0">
        <div class="row g-4 product-dashboard">
            <section class="col-12 col-xxl-8" aria-label="Product list">
                <section class="card card-surface" aria-labelledby="product-list-heading">
                    <div class="card-header py-2 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
                        <h2 id="product-list-heading" class="h6 mb-0">Click a product row to edit or delete, or add a new product with the button.</h2>
                        <button type="button" class="btn btn-purple" @onclick="OpenNewProduct">Add product</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <QuickGrid TGridItem="Product" Items="products.AsQueryable()" Pagination="paginationState" Class="table table-striped product-table mb-0" OnRowClick="HandleRowClick">
                                <PropertyColumn Property="product => product.Name" Title="Product" Sortable="true" />
                                <PropertyColumn Property="product => product.Price" Title="Price" Format="'$'0.00" Class="text-end" Sortable="true" />
                                <PropertyColumn Property="product => product.Description" Title="Description" />
                            </QuickGrid>
                        </div>
                    </div>
                    <div class="card-footer">
                        <Paginator State="paginationState" />
                    </div>
                </section>
            </section>

            <aside class="col-12 col-xxl-4 d-flex flex-column gap-4" aria-label="Product charts">
                @if (products.Count > 0)
                {
                    <section class="card card-surface" aria-labelledby="products-by-category-heading">
                        <div class="card-header py-2">
                            <h2 id="products-by-category-heading" class="h6 mb-0">Products by Category</h2>
                        </div>
                        <div class="card-body p-1">
                            <SfAccumulationChart Height="190px" Background="#242424">
                                <AccumulationChartLegendSettings Visible="true" Position="LegendPosition.Right">
                                    <AccumulationChartLegendFont Color="#f8f9fa" />
                                </AccumulationChartLegendSettings>
                                <AccumulationChartTooltipSettings Enable="true" />
                                <AccumulationChartSeriesCollection>
                                    <AccumulationChartSeries DataSource="categoryCounts"
                                                             XName="@nameof(CategoryProductCount.Category)"
                                                             YName="@nameof(CategoryProductCount.ProductCount)"
                                                             Type="AccumulationType.Pie"
                                                             InnerRadius="40%">
                                    </AccumulationChartSeries>
                                </AccumulationChartSeriesCollection>
                            </SfAccumulationChart>
                        </div>
                    </section>
                }

                <section class="card card-surface" aria-labelledby="products-by-price-heading">
                    <div class="card-header py-2">
                        <h2 id="products-by-price-heading" class="h6 mb-0">Products by Price Range</h2>
                    </div>
                    <div class="card-body p-1">
                        <SfChart Height="190px" Background="#242424">
                            <ChartTooltipSettings Enable="true" />
                            <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category"
                                               Title="Price range">
                                <ChartAxisLabelStyle Color="#f8f9fa" />
                                <ChartAxisTitleStyle Color="#f8f9fa" />
                            </ChartPrimaryXAxis>
                            <ChartPrimaryYAxis Title="Products">
                                <ChartAxisLabelStyle Color="#f8f9fa" />
                                <ChartAxisTitleStyle Color="#f8f9fa" />
                            </ChartPrimaryYAxis>
                            <ChartSeriesCollection>
                                <ChartSeries DataSource="priceRangeCounts"
                                             XName="@nameof(PriceRangeProductCount.PriceRange)"
                                             YName="@nameof(PriceRangeProductCount.ProductCount)"
                                             Type="ChartSeriesType.Bar"
                                             Fill="#75548d" />
                            </ChartSeriesCollection>
                        </SfChart>
                    </div>
                </section>
            </aside>
        </div>
    </div>
}

<ModalComponent @ref="productPUModal"
                DialogClass="modal-lg"
                SendBtnClickedBackToParent="HandleModalAction">
    <Title>
        @(isCreating ? "New product" : editProduct.Name)
        @if (!isCreating)
        {
            <span class="text-muted fs-6"> (ID: @editProduct.Id)</span>
        }
    </Title>
    <Body>
        <EditForm id="product-form" Model="editProduct" OnValidSubmit="SaveProductAsync">
            <DataAnnotationsValidator />
            @if (isConfirmingDelete)
            {
                <div class="alert alert-warning" role="alert">
                    Delete <strong>@editProduct.Name</strong>? This action cannot be undone.
                </div>
            }
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label" for="product-name">Product</label>
                    <InputText id="product-name" class="form-control" @bind-Value="editProduct.Name" />
                    <ValidationMessage For="@(() => editProduct.Name)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-category">Category</label>
                    <InputText id="product-category" class="form-control" @bind-Value="editProduct.Category" />
                    <ValidationMessage For="@(() => editProduct.Category)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-brand">Brand</label>
                    <InputText id="product-brand" class="form-control" @bind-Value="editProduct.Brand" />
                    <ValidationMessage For="@(() => editProduct.Brand)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-price">Price</label>
                    <InputNumber id="product-price" class="form-control" @bind-Value="editProduct.Price" />
                    <ValidationMessage For="@(() => editProduct.Price)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-stock">In stock</label>
                    <InputNumber id="product-stock" class="form-control" @bind-Value="editProduct.Stock" />
                    <ValidationMessage For="@(() => editProduct.Stock)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-sku">SKU</label>
                    <InputText id="product-sku" class="form-control" @bind-Value="editProduct.Sku" />
                    <ValidationMessage For="@(() => editProduct.Sku)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="product-weight">Weight (kg)</label>
                    <InputNumber id="product-weight" class="form-control" @bind-Value="editProduct.WeightKg" />
                    <ValidationMessage For="@(() => editProduct.WeightKg)" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="product-description">Description</label>
                    <InputTextArea id="product-description" class="form-control" @bind-Value="editProduct.Description" />
                    <ValidationMessage For="@(() => editProduct.Description)" />
                </div>
            </div>
            @if (operationError is not null)
            {
                <p class="text-danger mt-3 mb-0" role="alert">@operationError</p>
            }
        </EditForm>
    </Body>
    <Footer>
        @if (isConfirmingDelete)
        {
            <button type="button" class="btn btn-secondary" @onclick="CancelDelete" disabled="@isSaving">
                Keep product
            </button>
            <button type="button" class="btn btn-danger" @onclick="DeleteProductAsync" disabled="@isSaving">
                @(isSaving ? "Deleting..." : "Confirm delete")
            </button>
        }
        else
        {
            @if (!isCreating)
            {
                <button type="button" class="btn btn-danger" @onclick="RequestDelete" disabled="@isSaving">
                    Delete
                </button>
            }
            <button type="button" class="btn btn-secondary"
                    @onclick="() => productPUModal!.SendModalButtonClicked(ModalAction.Cancel)">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary" form="product-form" disabled="@isSaving">
                @(isSaving ? "Saving..." : isCreating ? "Create product" : "Save")
            </button>
        }
    </Footer>
</ModalComponent>

@code {
    private IReadOnlyList<Product> products = [];
    private readonly PaginationState paginationState = new() { ItemsPerPage = 12 };
    private bool isLoading = true;
    private string? loadError;
    private string? operationError;
    private bool isSaving;
    private bool isCreating;
    private bool isConfirmingDelete;
    private decimal? averagePrice => products.Count == 0 ? null : products.Average(product => product.Price);
    private int totalInventory => products.Sum(product => product.Stock);
    private Product? productBeingEdited;
    private ProductEditModel editProduct = new();
    private ModalComponent? productPUModal;
    private IReadOnlyList<CategoryProductCount> categoryCounts
    {
        get
        {
            if (products.Count == 0)
            {
                return [];
            }

            var totalProductCount = products.Count;
            return products
                .GroupBy(product => product.Category)
                .OrderBy(group => group.Key)
                .Select(group =>
                {
                    var productCount = group.Count();
                    return new CategoryProductCount(group.Key, productCount);
                })
                .ToArray();
        }
    }
    private IReadOnlyList<PriceRangeProductCount> priceRangeCounts
    {
        get
        {
            if (products.Count == 0)
            {
                return [];
            }

            const decimal rangeSize = 25m;
            var rangeCount = Math.Max(1, (int)decimal.Ceiling(products.Max(product => product.Price) / rangeSize));
            return Enumerable.Range(0, rangeCount)
                .Select(index =>
                {
                    var lowerBound = index * rangeSize;
                    var upperBound = lowerBound + rangeSize;
                    var productCount = products.Count(product =>
                        product.Price <= upperBound &&
                        (index == 0 ? product.Price >= lowerBound : product.Price > lowerBound));
                    var label = index == 0
                        ? $"${lowerBound:0}–${upperBound:0}"
                        : $">${lowerBound:0}–${upperBound:0}";

                    return new PriceRangeProductCount(label, productCount);
                })
                .ToArray();
        }
    }

    protected override void OnInitialized()
    {
        NotificationService.OnProductChanged += HandleProductChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ProductService.GetProductsAsync();
        }
        catch (IOException exception)
        {
            Logger.LogError(exception, "Could not read the product data file.");
            loadError = "Product data could not be loaded. Check the server logs for details.";
        }
        catch (System.Text.Json.JsonException exception)
        {
            Logger.LogError(exception, "The product data file contains invalid JSON.");
            loadError = "Product data could not be loaded. Check the server logs for details.";
        }
        catch (InvalidDataException exception)
        {
            Logger.LogError(exception, "The product data file does not contain a valid product list.");
            loadError = "Product data could not be loaded. Check the server logs for details.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleProductChanged(string message)
    {
        _ = InvokeAsync(() => ToastService.Show(message));
    }

    public void Dispose()
    {
        NotificationService.OnProductChanged -= HandleProductChanged;
    }

    private void OpenNewProduct()
    {
        isCreating = true;
        isConfirmingDelete = false;
        productBeingEdited = null;
        editProduct = new ProductEditModel();
        operationError = null;
        productPUModal!.Open();
    }

    private void HandleRowClick(Product product)
    {
        isCreating = false;
        isConfirmingDelete = false;
        productBeingEdited = product;
        editProduct = ProductEditModel.FromProduct(product);
        operationError = null;
        productPUModal!.Open();
    }

    private async Task SaveProductAsync()
    {
        if (!isCreating && productBeingEdited is null)
        {
            return;
        }

        isSaving = true;
        operationError = null;
        try
        {
            if (isCreating)
            {
                var createdProduct = await ProductService.CreateProductAsync(editProduct.ToProduct(0));
                products = products.Append(createdProduct).ToArray();
            }
            else
            {
                var productId = productBeingEdited!.Id;
                var updatedProduct = editProduct.ToProduct(productId);
                await ProductService.UpdateProductAsync(updatedProduct);
                products = products
                    .Select(product => product.Id == productId ? updatedProduct : product)
                    .ToArray();
            }

            await productPUModal!.SendModalButtonClicked(ModalAction.Save);
        }
        catch (IOException exception)
        {
            Logger.LogError(exception, "Could not save the product.");
            operationError = "Product changes could not be saved. Check the server logs for details.";
        }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogError(exception, "The product data file is not writable.");
            operationError = "Product changes could not be saved because the data file is not writable.";
        }
        catch (System.Text.Json.JsonException exception)
        {
            Logger.LogError(exception, "The product data file contains invalid JSON.");
            operationError = "Product changes could not be saved because the product data file is invalid.";
        }
        catch (InvalidDataException exception)
        {
            Logger.LogError(exception, "The product data file does not contain a valid product list.");
            operationError = "Product changes could not be saved because the product data file is invalid.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogError(exception, "Could not update product {ProductId}.", productBeingEdited?.Id);
            operationError = isCreating
                ? "A new product ID could not be assigned."
                : "This product is no longer available. Reload the catalog and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void RequestDelete()
    {
        isConfirmingDelete = true;
        operationError = null;
    }

    private void CancelDelete()
    {
        isConfirmingDelete = false;
        operationError = null;
    }

    private async Task DeleteProductAsync()
    {
        if (productBeingEdited is null)
        {
            return;
        }

        isSaving = true;
        operationError = null;
        try
        {
            var productId = productBeingEdited.Id;
            await ProductService.DeleteProductAsync(productId);
            products = products.Where(product => product.Id != productId).ToArray();
            await productPUModal!.SendModalButtonClicked(ModalAction.Delete);
        }
        catch (IOException exception)
        {
            Logger.LogError(exception, "Could not delete product {ProductId}.", productBeingEdited.Id);
            operationError = "Product could not be deleted. Check the server logs for details.";
        }
        catch (UnauthorizedAccessException exception)
        {
            Logger.LogError(exception, "The product data file is not writable.");
            operationError = "Product could not be deleted because the data file is not writable.";
        }
        catch (System.Text.Json.JsonException exception)
        {
            Logger.LogError(exception, "The product data file contains invalid JSON.");
            operationError = "Product could not be deleted because the product data file is invalid.";
        }
        catch (InvalidDataException exception)
        {
            Logger.LogError(exception, "The product data file does not contain a valid product list.");
            operationError = "Product could not be deleted because the product data file is invalid.";
        }
        catch (InvalidOperationException exception)
        {
            Logger.LogError(exception, "Could not find product {ProductId} to delete.", productBeingEdited.Id);
            operationError = "This product is no longer available. Reload the catalog and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task HandleModalAction(ModalAction action)
    {
        productBeingEdited = null;
        isCreating = false;
        isConfirmingDelete = false;
        operationError = null;
        return Task.CompletedTask;
    }

    private sealed class ProductEditModel
    {
        public int Id { get; set; }

        [Required]
        public string Name { get; set; } = string.Empty;

        [Required]
        public string Category { get; set; } = string.Empty;

        [Range(typeof(decimal), "0", "999999999")]
        public decimal Price { get; set; }

        [Range(0, int.MaxValue)]
        public int Stock { get; set; }

        [Required]
        public string Brand { get; set; } = string.Empty;

        [Required]
        public string Sku { get; set; } = string.Empty;

        [Range(typeof(decimal), "0", "999999999")]
        public decimal WeightKg { get; set; }

        [Required]
        public string Description { get; set; } = string.Empty;

        public static ProductEditModel FromProduct(Product product)
        {
            return new ProductEditModel
            {
                Id = product.Id,
                Name = product.Name,
                Category = product.Category,
                Price = product.Price,
                Stock = product.Stock,
                Brand = product.Brand,
                Sku = product.Sku,
                WeightKg = product.WeightKg,
                Description = product.Description
            };
        }

        public Product ToProduct(int id)
        {
            return new Product(id, Name, Category, Price, Stock, Brand, Sku, WeightKg, Description);
        }
    }

    private sealed record CategoryProductCount(string Category, int ProductCount);
    private sealed record PriceRangeProductCount(string PriceRange, int ProductCount);
}
