@page "/quickgrid"
@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>QuickGrid</PageTitle>

<h1>QuickGrid</h1>

<p>Select a product row to see its full details.</p>

<QuickGrid TGridItem="Product" Items="products.AsQueryable()" Class="table table-striped" OnRowClick="HandleRowClick">
    <PropertyColumn Property="product => product.Name" Title="Product" Sortable="true" />
    <PropertyColumn Property="product => product.Category" Title="Category" Sortable="true" />
    <PropertyColumn Property="product => product.Price" Title="Price" Sortable="true" />
    <PropertyColumn Property="product => product.Stock" Title="In stock" Sortable="true" />
</QuickGrid>

@if (selectedProduct is not null)
{
    <div class="alert alert-info mt-3">
        <div class="d-flex justify-content-between align-items-start">
            <h4>Selected Product</h4>
            <button type="button"
                    class="btn-close"
                    aria-label="Close product details"
                    @onclick="CloseProductDetails"></button>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@selectedProduct.Id</dd>
            <dt class="col-sm-3">Product</dt>
            <dd class="col-sm-9">@selectedProduct.Name</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@selectedProduct.Category</dd>
            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">@selectedProduct.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</dd>
            <dt class="col-sm-3">In stock</dt>
            <dd class="col-sm-9">@selectedProduct.Stock</dd>
            <dt class="col-sm-3">Brand</dt>
            <dd class="col-sm-9">@selectedProduct.Brand</dd>
            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@selectedProduct.Sku</dd>
            <dt class="col-sm-3">Weight</dt>
            <dd class="col-sm-9">@selectedProduct.WeightKg kg</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@selectedProduct.Description</dd>
        </dl>
    </div>
}
else
{
    <p class="text-muted mt-3">Click a row to see product details.</p>
}

@code {
    private Product? selectedProduct;

    private readonly List<Product> products =
    [
        new(1, "Alpine Tent", "Camping", 249.99m, 12, "Summit Trail", "ST-ALP-2", 3.2m, "A two-person, four-season tent built for alpine conditions."),
        new(2, "Trail Backpack", "Hiking", 89.50m, 34, "North Ridge", "NR-PACK-32", 1.1m, "A lightweight 32-liter pack with an adjustable harness."),
        new(3, "Insulated Bottle", "Accessories", 24.99m, 58, "EverPeak", "EP-BTL-750", 0.4m, "A vacuum-insulated stainless steel bottle that holds 750 ml."),
        new(4, "Sleeping Bag", "Camping", 119.00m, 19, "Summit Trail", "ST-SB-20", 1.6m, "A compact sleeping bag rated for temperatures down to 20 degrees."),
        new(5, "Trekking Poles", "Hiking", 64.95m, 27, "North Ridge", "NR-POLE-2", 0.6m, "Adjustable aluminum poles with cork grips and carbide tips."),
        new(6, "Headlamp", "Accessories", 39.99m, 41, "BrightPath", "BP-HL-400", 0.15m, "A rechargeable headlamp with multiple brightness modes."),
        new(7, "Camp Stove", "Camping", 74.50m, 16, "WildFlame", "WF-STOVE-1", 0.9m, "A compact single-burner stove for lightweight camp cooking."),
        new(8, "Rain Jacket", "Clothing", 139.00m, 23, "Cloudbreak", "CB-JKT-M", 0.5m, "A breathable, waterproof shell with an adjustable hood.")
    ];

    private void HandleRowClick(Product product)
    {
        selectedProduct = product;
    }

    private void CloseProductDetails()
    {
        selectedProduct = null;
    }

    private sealed record Product(
        int Id,
        string Name,
        string Category,
        decimal Price,
        int Stock,
        string Brand,
        string Sku,
        decimal WeightKg,
        string Description);
}
